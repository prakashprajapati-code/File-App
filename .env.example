# Upstash Redis (Vercel Marketplace -> Upstash)
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ICE servers (optional).
# Leave unset to use the built-in STUN list, or set '[]' to disable STUN/TURN
# entirely (same Wi-Fi only, no public address discovery).
# Format: JSON array of RTCIceServer objects.
# NEXT_PUBLIC_ICE_SERVERS='[{"urls":["stun:stun.cloudflare.com:3478"]}]'
#
# TURN is only needed when the LAN blocks direct device-to-device traffic.
# Every file byte then travels through the relay. NEXT_PUBLIC_* values are
# embedded in the browser bundle: use short-lived TURN credentials, never a
# long-lived secret.
# NEXT_PUBLIC_ICE_SERVERS='[{"urls":["stun:stun.cloudflare.com:3478"]},{"urls":["turn:turn.example.com:3478"],"username":"user","credential":"pass"}]'
